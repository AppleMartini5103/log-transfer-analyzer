# 테스트 픽스처는 OS 임시 디렉토리에 만들지만(tests/test_client_scenarios.cpp), 비정상
# 종료로 남은 구버전 잔여물이 커밋 후보로 올라오지 않도록 안전망을 둔다 (이슈 48)
client_scenario_*.bin

# Claude Code local settings (per-machine, never shared)
.claude/

# 3rdparty: commit only source tarball + build scripts.
# include/ and lib/ are regenerated from the tarball by build_linux.sh / build_window.bat
3rdparty/libuv/include/
3rdparty/libuv/lib/
3rdparty/catch2/include/
3rdparty/catch2/lib/
# imgui는 라이브러리를 만들지 않고 소스를 client 타깃에 직접 컴파일한다
# (3rdparty/imgui/build_window.bat 주석 참조) — include/ 와 src/ 모두 생성물.
3rdparty/imgui/include/
3rdparty/imgui/src/

# Python bytecode (E2E test driver)
__pycache__/
*.py[cod]

# Docker artifact directory (compose.yaml binds ./out to the container's workdir)
out/
logs/
